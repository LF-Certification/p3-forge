# shellcheck shell=bash

function p3forge::base() {
# Check if run before
if id tux &>/dev/null; then
    echo "p3forge::base: user \`tux\` already exists, skipping"
    return 0
fi

# Gather information
arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
os="$(grep '^ID=' /etc/os-release | sed 's/ID=//')"

# Install base apps and packages
case "$os" in
	alpine)
	apk upgrade
	apk add \
		bash-completion \
		ca-certificates \
		cloud-init \
		curl \
		gpg \
		less \
		man-db \
		nano \
		sudo \
		tree \
		vim
	apk add --repository=http://dl-cdn.alpinelinux.org/alpine/edge/testing/ \
		tldr
	;;
	ubuntu)
	p3forge::set_ubuntu_mirror
	;&
	debian)
	export DEBIAN_FRONTEND=noninteractive
	apt-get update
	apt-get upgrade -y
	# Egress to the apt mirror black-holes for ~90s after the systemd/udev
	# upgrade (route stays up); probe several targets to localize the cause.
	echo "=== network state (before wait) ==="
	ip route || true
	journalctl --no-pager --since -3min -u systemd-networkd -u systemd-udevd || true
	mirror="$(grep -rhoE 'https?://[^/[:space:]]+' /etc/apt/sources.list.d/ 2>/dev/null | sed -E 's#https?://##;/^security\./d' | head -1)"
	mirror="${mirror:-deb.debian.org}"
	for i in $(seq 30); do
		echo "=== probe attempt $i ==="
		gw="$(ip route | awk '/^default/{print $3; exit}')"
		mirror_ip="$(getent hosts "$mirror" | awk '{print $1; exit}')"
		ip neigh || true
		ss -tan 2>/dev/null | grep -E 'SYN-SENT|ESTAB' || true
		command -v resolvectl >/dev/null && resolvectl query "$mirror" 2>&1 | head -3 || true
		command -v ping >/dev/null && ping -c1 -W2 "$gw" 2>&1 | tail -1 || true
		mirror_up=
		for t in "gw=${gw}:80" "mirror_ip=${mirror_ip}:80" "mirror=${mirror}:80" "public=1.1.1.1:53" "imds=169.254.169.254:80"; do
			name="${t%%=*}"; hp="${t#*=}"; h="${hp%:*}"; p="${hp##*:}"
			[ -n "$h" ] || { echo "probe SKIP $name (unresolved)"; continue; }
			if timeout 5 bash -c "exec 3<>/dev/tcp/${h}/${p}" 2>/dev/null; then
				echo "probe OK   $name $h:$p"
				[ "$name" = mirror ] && mirror_up=1
			else
				echo "probe FAIL $name $h:$p"
			fi
		done
		[ -n "$mirror_up" ] && break
		sleep 3
	done
	echo "=== network state (after wait) ==="
	ip route || true
	journalctl --no-pager --since -3min -u systemd-networkd -u systemd-udevd || true
	apt-get purge -y unattended-upgrades
	apt-get install -y --no-install-recommends \
		apt-transport-https \
		bash-completion \
		ca-certificates \
		cloud-init \
		curl \
		gpg \
		less \
		man-db \
		nano \
		sudo \
		tldr-py \
		tree \
		util-linux \
		vim
	;;
esac

wget -q "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${arch}" \
  -O /usr/bin/yq && chmod +x /usr/bin/yq

# Create tux user
useradd --uid 60000 --create-home --shell /bin/bash --groups sudo tux || true
passwd --delete tux

# Grant tux passwordless sudo
echo "%sudo   ALL=(ALL:ALL) NOPASSWD: ALL" >/etc/sudoers.d/90-nopasswd

# Disable strict host key checking and create a shared SSH key so SSH commands work in scripts
echo -e "StrictHostKeyChecking no\nUserKnownHostsFile /dev/null" > /etc/ssh/ssh_config.d/10-disable-stricthostkeychecking.conf
cat <<EOF >~/.ssh/id_ed25519
-----BEGIN OPENSSH PRIVATE KEY-----
b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
QyNTUxOQAAACDJ/7ZpF1vDf7F8v+uZmGpM0tvAHpHV4rAL27m9zgb21AAAAJDS/0eK0v9H
igAAAAtzc2gtZWQyNTUxOQAAACDJ/7ZpF1vDf7F8v+uZmGpM0tvAHpHV4rAL27m9zgb21A
AAAEDfgDw+BSnV9Y876RSZxoJExTUJDt+AzmGDr6APG9cBrMn/tmkXW8N/sXy/65mYakzS
28AekdXisAvbub3OBvbUAAAACGR4c0BsdW5hAQIDBAU=
-----END OPENSSH PRIVATE KEY-----
EOF
chmod 0600 ~/.ssh/id_ed25519
echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMn/tmkXW8N/sXy/65mYakzS28AekdXisAvbub3OBvbU" |tee ~/.ssh/{id_ed25519.pub,authorized_keys}

# Enable FUSE user mounts (sometimes needed for lima)
[ ! -f /etc/fuse.conf ] || sed -i 's/^#user_allow_other/user_allow_other/' /etc/fuse.conf

cleanup::postbuild
p3forge::wipe_machine_id
}

